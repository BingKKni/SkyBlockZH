# Gradle / build output 
# Regenerated by `./gradlew build`, and .gradle/ additionally holds absolute paths from this
# machine. build/ also contains the minified copy of the corpus (build/minified-corpus), which
# is derived from original_text/ and must never be edited or committed on its own.
.gradle/
build/
out/
classes/

# editors / IDEs
*.launch

.idea/
*.iml
*.ipr
*.iws

.settings/
.vscode/
.opencode/
.playwright-mcp/
bin/
.classpath
.project

# OS 
*.DS_Store
Thumbs.db
desktop.ini

# Fabric / Minecraft runtime 
run/

# session data from a real client
logs/

# JVM crash / profiling artefacts
hs_err_*.log
replay_*.log
*.hprof
*.jfr

# local scratch
# Probe input for `./gradlew probe`, written by hand to redraw one line at a time.
probe.txt

# local translation/research helpers; build-time checks live under gradle/ instead
/tools/
.claude/RESUME.md

