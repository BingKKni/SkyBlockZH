    {
      "id": "dual_01637c6d9b28",
      "text": "Small cracks begin to form in the mound...",
      "raw": "§7§oSmall cracks begin to form in the mound...",
      "context": "双机本轮实测；颜色依照服务器原文。",
      "placeholders": [],
      "translate": true,
      "zh": "土丘上开始出现细小的裂缝……"
    },
    {
      "id": "dual_b6b8d5a7df54",
      "text": "The cracks seem to be getting larger, keep hitting it!",
      "raw": "§7§oThe cracks seem to be getting larger, keep hitting it!",
      "context": "双机本轮实测；颜色依照服务器原文。",
      "placeholders": [],
      "translate": true,
      "zh": "裂缝似乎越来越大了，继续敲!"
    },
    {
      "id": "dual_22681cfee050",
      "text": "Chunks of the mound begin falling away...",
      "raw": "§7§oChunks of the mound begin falling away...",
      "context": "双机本轮实测；颜色依照服务器原文。",
      "placeholders": [],
      "translate": true,
      "zh": "土丘开始一块块剥落……"
    },
    {
      "id": "dual_4e11e13811c8",
      "text": "The mound is about to fall to pieces! Keep going!",
      "raw": "§7§oThe mound is about to fall to pieces! Keep going!",
      "context": "双机本轮实测；颜色依照服务器原文。",
      "placeholders": [],
      "translate": true,
      "zh": "土丘就快散架了! 继续!"
    },
    {
      "id": "dual_d75264afeae0",
      "text": "The mound falls apart, but nothing is inside...",
      "raw": "§7§oThe mound falls apart, but nothing is inside...",
      "context": "双机本轮实测；颜色依照服务器原文。",
      "placeholders": [],
      "translate": true,
      "zh": "土丘散开了，里面却空空如也……"
    },
    {
      "id": "dual_bc49243c3f17",
      "text": "You ran headfirst into the wall. Some more cracks appeared in it...",
      "raw": "§7§oYou ran headfirst into the wall. Some more cracks appeared in it...",
      "context": "双机本轮实测；颜色依照服务器原文。",
      "placeholders": [],
      "translate": true,
      "zh": "你一头撞上了墙，墙面又多了几道裂缝……"
    },
    {
      "id": "dual_c430eef957f7",
      "text": "Keep running into the wall! More cracks are forming!",
      "raw": "§7§oKeep running into the wall! More cracks are forming!",
      "context": "双机本轮实测；颜色依照服务器原文。",
      "placeholders": [],
      "translate": true,
      "zh": "继续撞墙! 裂缝越来越多了!"
    },
    {
      "id": "dual_74f277840d83",
      "text": "You destroyed the wall! Maybe something was hiding behind it...",
      "raw": "§7§oYou destroyed the wall! Maybe something was hiding behind it...",
      "context": "双机本轮实测；颜色依照服务器原文。",
      "placeholders": [],
      "translate": true,
      "zh": "你撞塌了墙! 后面似乎藏着什么……"
    },
    {
      "id": "dual_c5bc8a5685c4",
      "text": "A rumbling sound can be heard, and the door at the back of the chamber opens...",
      "raw": "§7§oA rumbling sound can be heard, and the door at the back of the chamber opens...",
      "context": "双机本轮实测；颜色依照服务器原文。",
      "placeholders": [],
      "translate": true,
      "zh": "一阵隆隆声响起，洞室深处的门缓缓打开……"
    },
