      "id": "forge_slot",
      "context": "主菜单里每一个熔炼槽的格子名",
      "raw": "§aSlot #%s",
      "text": "Slot #%s",
      "placeholders": [
        {"token": "%s", "desc": "槽位编号,1 到 7", "type": "number", "example": "3"}
