      "id": "nov07_guide_fishing_unlock",
      "context": "服务器本轮采集；完整语句匹配，保留实时颜色。",
      "text": "Talk to %1$s at the Fishing Outpost in the Hub to unlock this!",
      "raw": "§cTalk to §d%1$s §cat the §bFishing Outpost §cin the Hub to unlock this!",
      "placeholders": [
        {
          "token": "%1$s",
          "type": "npc_name",
          "example": "Angler Angus",
          "desc": "随服务器变化的值"
        }
      ],
      "translate": true,
      "zh": "前往大厅的钓鱼前哨站，与 %1$s 交谈以解锁此功能!",
      "segments": [
        {
          "color": "§c",
          "text": "Talk to ",
          "zh": "前往大厅的",
          "order": 0
        },
        {
          "color": "§d",
          "text": "%1$s ",
          "zh": "%1$s",
          "order": 3
        },
        {
          "color": "§c",
          "text": "at the ",
          "zh": " 交谈以解锁此功能!",
          "order": 4
        },
        {
          "color": "§b",
          "text": "Fishing Outpost ",
          "zh": "钓鱼前哨站",
          "order": 1
        },
        {
          "color": "§c",
          "text": "in the Hub to unlock this!",
          "zh": "，与 ",
          "order": 2
        }
      ],
      "samples": [
        [
          "§cTalk to §dAngler Angus §cat the §bFishing",
          "§bOutpost §cin the Hub to unlock this!"
        ],
        [
          "§cTalk to §bGavin §cat the §bFishing Outpost",
          "§cin the Hub to unlock this!"
        ]
      ]
    },
